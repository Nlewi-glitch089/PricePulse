# Copy this file to .env (which Git ignores) and fill in your own values. Never commit .env.

# Your MongoDB connection string. Paste it after the = sign, then save the file.
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#   Local MongoDB:  mongodb://127.0.0.1:27017
# Left empty, the app stops at start-up and says MONGODB_URI is not set.
MONGODB_URI=

# Database name (created automatically on first write)
MONGODB_DB=pricepulse

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Left empty in development, a random one is used and logins reset on restart.
SESSION_SECRET=

# "development" for local HTTP, "production" when served over HTTPS
# (production enables Secure cookies and requires SESSION_SECRET)
NODE_ENV=development

PORT=3000

# Optional: how much the server logs: debug, info, warn, error, or silent.
# Defaults to debug in development and info in production.
# LOG_LEVEL=info

# Optional: an automatic price source you are authorized to use (see README).
# Leave PRICE_PROVIDER_HTTP_ENDPOINT empty to enter prices by hand.
PRICE_PROVIDER_HTTP_NAME=
PRICE_PROVIDER_HTTP_ENDPOINT=
PRICE_PROVIDER_HTTP_API_KEY=
PRICE_PROVIDER_HTTP_HOSTS=
PRICE_PROVIDER_TIMEOUT_MS=8000
# Minutes between automatic refreshes; 0 turns scheduled refresh off
PRICE_REFRESH_INTERVAL_MINUTES=0
